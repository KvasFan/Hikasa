{
  "id": "upper",
  "origin": "user",
  "path": "<TMP>/config/formats/upper.toml",
  "enabled": true,
  "format": {
    "schema_version": 1,
    "id": "upper",
    "name": "Upper",
    "description": "",
    "kind": "text",
    "mask": "*.up",
    "conversion": {
      "method": "external",
      "load": "conv %s %t",
      "save": null,
      "filename_encoding": "unicode",
      "timeout_secs": 60
    },
    "encoding": {
      "mode": "auto",
      "fallback": null,
      "label": null
    },
    "text": {
      "tab_size": 4,
      "tab_as_spaces": false,
      "chars_per_line_limit": null,
      "lines_independent": false,
      "column_based": false,
      "ctrl_z_eof": false,
      "save_trim_trailing_ws": false,
      "save_leading_spaces_to_tabs": false,
      "word_chars": ""
    },
    "elements": {},
    "grammar": [],
    "line_weight": [],
    "table": null
  },
  "compile_error": null
}
