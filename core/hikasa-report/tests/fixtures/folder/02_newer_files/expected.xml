      <right name="same_within_tolerance.txt" size="1" modified="2026-01-01T00:00:00Z"/>
    </entry>
    <entry name="size_only.txt" path="size_only.txt" state="different" marker="!" kind="file">
      <left name="size_only.txt" size="3" modified="2026-01-01T00:00:00Z"/>
      <right name="size_only.txt" size="4" modified="2026-01-01T00:00:00Z"/>
    </entry>
  </tree>
  <summary verdict="differences" complete="true">
