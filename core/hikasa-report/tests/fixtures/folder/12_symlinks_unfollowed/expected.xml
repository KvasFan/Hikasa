<?xml version="1.0" encoding="UTF-8"?>
<hikasa-report xmlns="urn:hikasa:report:1" version="1" type="folder">
  <header>
    <title>Folder Compare</title>
    <side id="left" spec="/l"/>
    <side id="right" spec="/r"/>
    <mode display="all" ignore-unimportant="false" folders="structure" suppress-filters="false"/>
    <rules>size, timestamps (2 s); filters: none</rules>
  </header>
  <tree>
    <entry name="target.txt" path="target.txt" state="same" marker="=" kind="file">
      <left name="target.txt" size="1" modified="2026-01-01T00:00:00Z"/>
      <right name="target.txt" size="1" modified="2026-01-01T00:00:00Z"/>
    </entry>
    <entry name="moved_link" path="moved_link" state="different" marker="!" kind="link">
      <left name="moved_link" size="10" modified="2026-01-01T00:00:00Z" link-target="target.txt"/>
      <right name="moved_link" size="9" modified="2026-01-01T00:00:00Z" link-target="other.txt"/>
    </entry>
    <entry name="same_link" path="same_link" state="same" marker="=" kind="link">
