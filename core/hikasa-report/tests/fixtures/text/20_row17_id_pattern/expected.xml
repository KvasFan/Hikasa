<?xml version="1.0" encoding="UTF-8"?>
<hikasa-report xmlns="urn:hikasa:report:1" version="1" type="text">
  <header>
    <title>Text Compare</title>
    <side id="left" spec="/l/left.txt" encoding="UTF-8" bom="false" eol="lf" binary="false"/>
    <side id="right" spec="/r/right.txt" encoding="UTF-8" bom="false" eol="lf" binary="false"/>
    <mode display="all" ignore-unimportant="false"/>
    <rules>format: Everything Else; algorithm: standard (auto); skew: 300; closeness: 500‰; never align: no; unimportant: regex "\\$Id:[^$]*\\$"; line endings: ignored; orphan lines: always important</rules>
  </header>
  <rows>
    <row state="changed" importance="unimportant" left="1" right="1"><l>$Id: 1<u>2</u> $</l><r>$Id: 1<u>3</u> $</r></row>
    <row state="same" left="2" right="2"><l>body</l><r>body</r></row>
  </rows>
  <summary verdict="unimportant_only">
    <count group="rows" name="total" value="2"/>
    <count group="rows" name="same" value="1"/>
    <count group="rows" name="changed" value="1"/>
    <count group="rows" name="left-only" value="0"/>
    <count group="rows" name="right-only" value="0"/>
    <count group="rows" name="important" value="0"/>
    <count group="rows" name="unimportant" value="1"/>
    <count group="sections" name="total" value="1"/>
    <count group="sections" name="important" value="0"/>
    <count group="sections" name="unimportant" value="1"/>
    <count group="important-lines" name="added" value="0"/>
    <count group="important-lines" name="deleted" value="0"/>
    <count group="important-lines" name="changed" value="0"/>
    <count group="important-lines" name="original" value="0"/>
    <count group="unimportant-lines" name="added" value="0"/>
    <count group="unimportant-lines" name="deleted" value="0"/>
    <count group="unimportant-lines" name="changed" value="1"/>
    <count group="unimportant-lines" name="original" value="1"/>
    <count group="lines" name="left" value="2"/>
    <count group="lines" name="right" value="2"/>
  </summary>
</hikasa-report>
