<?xml version="1.0" encoding="UTF-8"?>
<hikasa-report xmlns="urn:hikasa:report:1" version="1" type="text">
  <header>
    <title>Text Compare</title>
    <side id="left" spec="/l/left.txt" encoding="UTF-8" bom="false" eol="mixed" binary="false"/>
    <side id="right" spec="/r/right.txt" encoding="UTF-8" bom="false" eol="lf" binary="false"/>
    <mode display="all" ignore-unimportant="false"/>
    <rules>format: Everything Else; algorithm: standard (auto); skew: 300; closeness: 500‰; never align: no; unimportant: none; line endings: compared; orphan lines: always important</rules>
  </header>
  <rows>
    <row state="changed" importance="important" left="1" right="1"><l>a</l><r>a</r></row>
    <row state="same" left="2" right="2"><l>b</l><r>b</r></row>
    <row state="changed" importance="important" left="3" right="3"><l>c</l><r>c</r></row>
    <row state="same" left="4" right="4"><l>d</l><r>d</r></row>
  </rows>
  <summary verdict="important_differences">
    <count group="rows" name="total" value="4"/>
    <count group="rows" name="same" value="2"/>
    <count group="rows" name="changed" value="2"/>
    <count group="rows" name="left-only" value="0"/>
    <count group="rows" name="right-only" value="0"/>
    <count group="rows" name="important" value="2"/>
    <count group="rows" name="unimportant" value="0"/>
    <count group="sections" name="total" value="2"/>
    <count group="sections" name="important" value="2"/>
    <count group="sections" name="unimportant" value="0"/>
    <count group="important-lines" name="added" value="0"/>
    <count group="important-lines" name="deleted" value="0"/>
    <count group="important-lines" name="changed" value="2"/>
    <count group="important-lines" name="original" value="2"/>
    <count group="unimportant-lines" name="added" value="0"/>
    <count group="unimportant-lines" name="deleted" value="0"/>
    <count group="unimportant-lines" name="changed" value="0"/>
    <count group="unimportant-lines" name="original" value="0"/>
    <count group="lines" name="left" value="4"/>
    <count group="lines" name="right" value="4"/>
  </summary>
</hikasa-report>
