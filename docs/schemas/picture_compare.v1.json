{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:hikasa:schema:picture_compare.v1",
  "title": "hikasa.picture_compare.v1",
  "description": "The result of `hikasa picture compare --json` (the `result` member of the envelope), also of `session run` of a Picture Compare session. Contract docs/design/m2-contracts.md §1.12.24 (D-347). Counts are JSON numbers; percentages are numbers rounded to 4 decimals; arrays are never null. Within version 1 keys are only added, with this schema updated in the same change.",
  "type": "object",
  "additionalProperties": false,
  "required": ["left", "right", "options", "geometry", "verdict", "stats", "probes", "diff_output", "warnings"],
  "properties": {
    "left": { "$ref": "#/$defs/side" },
    "right": { "$ref": "#/$defs/side" },
    "options": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "tolerance", "blend", "ignore_unimportant", "auto_scale", "tone_map", "orientation", "offset"],
      "properties": {
        "mode": { "$ref": "#/$defs/mode" },
        "tolerance": { "type": "integer", "minimum": 0, "maximum": 255 },
        "blend": { "description": "The right picture's weight in percent (50 outside blend mode).", "type": "integer", "minimum": 0, "maximum": 100 },
        "ignore_unimportant": { "type": "boolean" },
        "auto_scale": { "type": "boolean" },
        "tone_map": { "$ref": "#/$defs/tone_map" },
        "orientation": {
          "description": "Each side's orientation (`--left-orientation`, `--right-orientation`, composed to one word).",
          "type": "object",
          "additionalProperties": false,
          "required": ["left", "right"],
          "properties": {
            "left": { "$ref": "#/$defs/orientation" },
            "right": { "$ref": "#/$defs/orientation" }
          }
        },
        "offset": {
          "description": "The right picture's origin in left coordinates: `[dx, dy]`.",
          "type": "array",
          "items": { "type": "integer", "minimum": -1048576, "maximum": 1048576 },
          "minItems": 2,
          "maxItems": 2
        }
      }
    },
    "geometry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["area", "scaled", "scaled_to"],
      "properties": {
        "area": { "description": "The compared area in left-picture coordinates.", "$ref": "#/$defs/rect" },
        "scaled": { "description": "The side Auto Scale resampled, `null` for none.", "enum": ["left", "right", null] },
        "scaled_to": {
          "description": "Its size after scaling: `[width, height]`, or `null`.",
          "anyOf": [
            { "type": "null" },
            { "type": "array", "items": { "$ref": "#/$defs/count" }, "minItems": 2, "maxItems": 2 }
          ]
        }
      }
    },
    "verdict": {
      "description": "D-339: `binary_same` (identical bytes), `rules_same` (every pixel same), `unimportant_only` (similar pixels only), `important_differences`.",
      "type": "object",
      "additionalProperties": false,
      "required": ["result"],
      "properties": {
        "result": { "enum": ["binary_same", "rules_same", "unimportant_only", "important_differences"] }
      }
    },
    "stats": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "pixels",
        "same",
        "similar",
        "different",
        "left_only",
        "right_only",
        "same_percent",
        "similar_percent",
        "different_percent",
        "max_distance",
        "mean_distance",
        "bounds"
      ],
      "properties": {
        "pixels": { "description": "Positions covered by at least one picture.", "$ref": "#/$defs/count" },
        "same": { "$ref": "#/$defs/count" },
        "similar": { "$ref": "#/$defs/count" },
        "different": { "$ref": "#/$defs/count" },
        "left_only": { "$ref": "#/$defs/count" },
        "right_only": { "$ref": "#/$defs/count" },
        "same_percent": { "$ref": "#/$defs/percent" },
        "similar_percent": { "$ref": "#/$defs/percent" },
        "different_percent": { "$ref": "#/$defs/percent" },
        "max_distance": { "$ref": "#/$defs/distance" },
        "mean_distance": { "type": "number", "minimum": 0, "maximum": 255 },
        "bounds": {
          "description": "The bounds of the positions that are not same, in area coordinates; `null` for none.",
          "anyOf": [{ "type": "null" }, { "$ref": "#/$defs/rect" }]
        }
      }
    },
    "probes": {
      "description": "The `--probe` results in order.",
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["x", "y", "left", "right", "distance", "class"],
        "properties": {
          "x": { "$ref": "#/$defs/count" },
          "y": { "$ref": "#/$defs/count" },
          "left": { "anyOf": [{ "type": "null" }, { "$ref": "#/$defs/probe_side" }] },
          "right": { "anyOf": [{ "type": "null" }, { "$ref": "#/$defs/probe_side" }] },
          "distance": { "$ref": "#/$defs/distance" },
          "class": { "enum": ["same", "similar", "different", "outside"] }
        }
      }
    },
    "diff_output": {
      "description": "The image `--diff-output` wrote, `null` when none was written.",
      "anyOf": [
        { "type": "null" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["target", "pane", "mode", "width", "height", "checkerboard"],
          "properties": {
            "target": { "description": "The file's canonical spec, or the target as given (`-`, `clipboard://`).", "type": "string" },
            "pane": { "enum": ["difference", "left", "right"] },
            "mode": { "$ref": "#/$defs/mode" },
            "width": { "$ref": "#/$defs/count" },
            "height": { "$ref": "#/$defs/count" },
            "checkerboard": { "type": "boolean" }
          }
        }
      ]
    },
    "warnings": { "type": "array", "items": { "$ref": "#/$defs/warning" } }
  },
  "$defs": {
    "count": { "type": "integer", "minimum": 0 },
    "percent": { "type": "number", "minimum": 0, "maximum": 100 },
    "distance": { "type": "integer", "minimum": 0, "maximum": 255 },
    "mode": { "enum": ["tolerance", "range", "blend"] },
    "tone_map": { "enum": ["clamp", "reinhard"] },
    "orientation": { "enum": ["none", "cw", "ccw", "180", "flip-h", "flip-v", "transpose", "transverse"] },
    "rect": {
      "type": "object",
      "additionalProperties": false,
      "required": ["x", "y", "width", "height"],
      "properties": {
        "x": { "type": "integer" },
        "y": { "type": "integer" },
        "width": { "$ref": "#/$defs/count" },
        "height": { "$ref": "#/$defs/count" }
      }
    },
    "probe_side": {
      "description": "The pixel of one side at the probed position: its coordinates in the oriented (and scaled) picture and `[r, g, b, a]`.",
      "type": "object",
      "additionalProperties": false,
      "required": ["x", "y", "rgba"],
      "properties": {
        "x": { "$ref": "#/$defs/count" },
        "y": { "$ref": "#/$defs/count" },
        "rgba": {
          "type": "array",
          "items": { "type": "integer", "minimum": 0, "maximum": 255 },
          "minItems": 4,
          "maxItems": 4
        }
      }
    },
    "file_format": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "kind", "reason"],
      "properties": {
        "id": { "type": ["string", "null"] },
        "name": { "type": "string" },
        "kind": { "type": "string" },
        "reason": {
          "anyOf": [
            { "type": "null" },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["reason", "id", "mask"],
              "properties": {
                "reason": { "enum": ["mask", "forced", "fallback"] },
                "id": { "type": ["string", "null"] },
                "mask": { "type": ["string", "null"] }
              }
            }
          ]
        }
      }
    },
    "side": {
      "description": "`width` and `height` after the EXIF orientation; `color`, `bit_depth` and `has_alpha` describe the source.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "spec",
        "size",
        "mtime",
        "format",
        "decoder",
        "width",
        "height",
        "color",
        "bit_depth",
        "has_alpha",
        "frames",
        "orientation",
        "tone_map",
        "converted"
      ],
      "properties": {
        "spec": { "type": "string" },
        "size": { "description": "File size in bytes.", "$ref": "#/$defs/count" },
        "mtime": { "type": ["string", "null"] },
        "format": {
          "description": "The Hikasa format of the picture kind, `null` when none matched.",
          "anyOf": [{ "type": "null" }, { "$ref": "#/$defs/file_format" }]
        },
        "decoder": { "enum": ["png", "jpeg", "gif", "bmp", "ico", "tiff", "webp", "tga", "pnm", "qoi", "exr", "hdr"] },
        "width": { "$ref": "#/$defs/count" },
        "height": { "$ref": "#/$defs/count" },
        "color": { "enum": ["l8", "la8", "rgb8", "rgba8", "l16", "la16", "rgb16", "rgba16", "rgb32f", "rgba32f"] },
        "bit_depth": { "type": "integer", "minimum": 1 },
        "has_alpha": { "type": "boolean" },
        "frames": { "description": "Frames of the container, `null` when unknown.", "type": ["integer", "null"], "minimum": 0 },
        "orientation": {
          "description": "The EXIF orientation applied, `null` for none.",
          "anyOf": [{ "type": "null" }, { "$ref": "#/$defs/orientation" }]
        },
        "tone_map": {
          "description": "The tone map of an HDR or OpenEXR picture, `null` otherwise.",
          "anyOf": [{ "type": "null" }, { "$ref": "#/$defs/tone_map" }]
        },
        "converted": { "description": "Decoded from its format's load conversion.", "type": "boolean" }
      }
    },
    "warning": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "message", "spec"],
      "properties": {
        "code": { "type": "string" },
        "message": { "type": "string" },
        "spec": { "type": ["string", "null"] }
      }
    }
  }
}
